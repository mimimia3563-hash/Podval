-- Actions
do
	local page = createPage()
	pages.Actions = page

	local cycleConfig = CONFIG.TeleportCycle
	local cycleRunning = false
	local stopCycleRequested = false

	local teleportCard = createCard(
		page,
		"Teleport loop",
		"First position → Final position. The loop resumes automatically after a respawn."
	)

	local tpBtn = create("TextButton", {
		Parent = teleportCard,
		LayoutOrder = nextOrder(),
		Size = UDim2.new(1, 0, 0, 40),
		Text = "Start teleport loop",
		TextColor3 = Theme.Text,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		BorderSizePixel = 0,
	}, { corner(8) })
	addButtonFeedback(tpBtn, Theme.Elevated, Theme.Stroke, Theme.Surface)

	-- Keeps waiting for a living character if the game respawns the player.
	-- This script does not kill or damage the character.
	local function waitForLivingCharacter()
		while not stopCycleRequested do
			local char = player.Character
			if char then
				local root = char:FindFirstChild("HumanoidRootPart")
				local humanoid = char:FindFirstChildOfClass("Humanoid")
				if char == player.Character and root and humanoid and humanoid.Health > 0 then
					return char, root, humanoid
				end
			end
			task.wait(0.1)
		end
		return nil, nil, nil
	end

	tpBtn.MouseButton1Click:Connect(function()
		-- Clicking while the loop is active requests a clean stop.
		if cycleRunning then
			stopCycleRequested = true
			tpBtn.Text = "Stopping..."
			return
		end

		cycleRunning = true
		stopCycleRequested = false
		tpBtn.Text = "Stop teleport loop"

		task.spawn(function()
			local loopEnabled = cycleConfig.LoopEnabled == true
			local configuredCount = math.floor(tonumber(cycleConfig.LoopCount) or 1)
			local loopCount = math.max(0, configuredCount)
			local completedCycles = 0

			while not stopCycleRequested do
				-- If the character is dead or respawning, wait until the new one is ready.
				local char, root, humanoid = waitForLivingCharacter()
				if stopCycleRequested or not char then
					break
				end

				-- Start/restart this cycle on the currently living character.
				if char ~= player.Character or not root.Parent or humanoid.Health <= 0 then
					task.wait(0.1)
					continue
				end

				local movedToFirst = pcall(function()
					root.CFrame = CFrame.new(cycleConfig.FirstPosition)
				end)
				if not movedToFirst then
					task.wait(0.1)
					continue
				end
				notify("First teleport complete")

				-- Wait in short steps so a respawn is detected promptly.
				local waitSeconds = math.max(0, tonumber(cycleConfig.WaitSeconds) or 1)
				local waitStarted = os.clock()
				local characterChanged = false
				while os.clock() - waitStarted < waitSeconds and not stopCycleRequested do
					if char ~= player.Character or not root.Parent or humanoid.Health <= 0 then
						characterChanged = true
						break
					end
					task.wait(math.min(0.1, waitSeconds - (os.clock() - waitStarted)))
				end

				if stopCycleRequested then
					break
				end

				-- If a respawn happened mid-cycle, do not count it; restart from
				-- FirstPosition when the new character becomes available.
				if characterChanged or char ~= player.Character or not root.Parent or humanoid.Health <= 0 then
					continue
				end

				-- Final teleport. No health, damage, or death operation is performed.
				local movedToFinal = pcall(function()
					root.CFrame = CFrame.new(cycleConfig.FinalPosition)
				end)
				if not movedToFinal then
					continue
				end
				notify("Final teleport complete")
				completedCycles += 1

				if not loopEnabled then
					break
				end

				-- LoopCount = 0 means unlimited repeats until Stop is clicked.
				if loopCount > 0 and completedCycles >= loopCount then
					break
				end

				task.wait(math.max(0, tonumber(cycleConfig.LoopDelaySeconds) or 1))
			end

			cycleRunning = false
			stopCycleRequested = false
			if tpBtn.Parent then
				tpBtn.Text = "Start teleport loop"
			end
		end)
	end)
end

-- Move (speed / fly / noclip)
do
	local RunService = game:GetService("RunService")
	local page = createPage()
	pages.Move = page

	local state = { Speed = false, Fly = false, Noclip = false }
	local values = { WalkSpeed = 50, FlySpeed = 60 }
	local flyUp, flyDown = false, false
	local flyBV, flyBG = nil, nil
	local savedWalkSpeed = nil
	local noclipOriginal = {}
	local quick = {}
	local setState -- assigned below (the fly pad's OFF button needs it)

	-- On-screen fly controls for touch devices: ▼  ▲  ✕(fly off)
	-- Sits at the bottom right, just left of Roblox's jump button.
	-- The jump button itself also works as "up" while flying.
	local flyPad = create("Frame", {
		Name = "FlyPad",
		Parent = gui,
		Visible = false,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -130, 1, -24),
