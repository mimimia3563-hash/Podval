-- Actions
do
	local page = createPage()
	pages.Actions = page

	local cycleConfig = CONFIG.TeleportCycle
	local cycleRunning = false
	local stopCycleRequested = false

	local teleportCard = createCard(
		page,
		"Teleport loop",
		"First position → Final position. The loop resumes automatically after a respawn."
	)

	local tpBtn = create("TextButton", {
		Parent = teleportCard,
		LayoutOrder = nextOrder(),
		Size = UDim2.new(1, 0, 0, 40),
		Text = "Start teleport loop",
		TextColor3 = Theme.Text,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		BorderSizePixel = 0,
	}, { corner(8) })
	addButtonFeedback(tpBtn, Theme.Elevated, Theme.Stroke, Theme.Surface)

	-- Keeps waiting for a living character if the game respawns the player.
	-- This script does not kill or damage the character.
	local function waitForLivingCharacter()
		while not stopCycleRequested do
			local char = player.Character
			if char then
				local root = char:FindFirstChild("HumanoidRootPart")
				local humanoid = char:FindFirstChildOfClass("Humanoid")
				if char == player.Character and root and humanoid and humanoid.Health > 0 then
					return char, root, humanoid
				end
			end
			task.wait(0.1)
		end
		return nil, nil, nil
	end

	tpBtn.MouseButton1Click:Connect(function()
		-- Clicking while the loop is active requests a clean stop.
		if cycleRunning then
			stopCycleRequested = true
			tpBtn.Text = "Stopping..."
			return
		end

		cycleRunning = true
		stopCycleRequested = false
		tpBtn.Text = "Stop teleport loop"

		task.spawn(function()
			local loopEnabled = cycleConfig.LoopEnabled == true
			local configuredCount = math.floor(tonumber(cycleConfig.LoopCount) or 1)
			local loopCount = math.max(0, configuredCount)
			local completedCycles = 0

			while not stopCycleRequested do
				-- If the character is dead or respawning, wait until the new one is ready.
				local char, root, humanoid = waitForLivingCharacter()
				if stopCycleRequested or not char then
					break
				end

				-- Start/restart this cycle on the currently living character.
				if char ~= player.Character or not root.Parent or humanoid.Health <= 0 then
					task.wait(0.1)
					continue
				end

				local movedToFirst = pcall(function()
					root.CFrame = CFrame.new(cycleConfig.FirstPosition)
				end)
				if not movedToFirst then
					task.wait(0.1)
					continue
				end
				notify("First teleport complete")

				-- Wait in short steps so a respawn is detected promptly.
				local waitSeconds = math.max(0, tonumber(cycleConfig.WaitSeconds) or 1)
				local waitStarted = os.clock()
				local characterChanged = false
				while os.clock() - waitStarted < waitSeconds and not stopCycleRequested do
					if char ~= player.Character or not root.Parent or humanoid.Health <= 0 then
						characterChanged = true
						break
					end
					task.wait(math.min(0.1, waitSeconds - (os.clock() - waitStarted)))
				end

				if stopCycleRequested then
					break
				end

				-- If a respawn happened mid-cycle, do not count it; restart from
				-- FirstPosition when the new character becomes available.
				if characterChanged or char ~= player.Character or not root.Parent or humanoid.Health <= 0 then
					continue
				end

				-- Final teleport. No health, damage, or death operation is performed.
				local movedToFinal = pcall(function()
					root.CFrame = CFrame.new(cycleConfig.FinalPosition)
				end)
				if not movedToFinal then
					continue
				end
				notify("Final teleport complete")
				completedCycles += 1

				if not loopEnabled then
					break
				end

				-- LoopCount = 0 means unlimited repeats until Stop is clicked.
				if loopCount > 0 and completedCycles >= loopCount then
					break
				end

				task.wait(math.max(0, tonumber(cycleConfig.LoopDelaySeconds) or 1))
			end

			cycleRunning = false
			stopCycleRequested = false
			if tpBtn.Parent then
				tpBtn.Text = "Start teleport loop"
			end
		end)
	end)

	-- Item watcher: teleport to special items when they spawn, then go back
	local itemConfig = CONFIG.ItemTeleport
	local itemNames = {}
	for _, n in ipairs(itemConfig.Names) do
		itemNames[n] = true
	end

	local itemCard = createCard(
		page,
		"Gems",
		"Gem names: " .. table.concat(itemConfig.Names, ", ") .. ". The watcher teleports you to a Gem when it spawns, then back. The random button goes to a Gem that exists right now."
	)
	local itemBtn = create("TextButton", {
		Parent = itemCard,
		LayoutOrder = nextOrder(),
		Size = UDim2.new(1, 0, 0, 40),
		Text = "Start gem watcher",
		TextColor3 = Theme.Text,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		BorderSizePixel = 0,
	}, { corner(8) })
	addButtonFeedback(itemBtn, Theme.Elevated, Theme.Stroke, Theme.Surface)
	local randomBtn = create("TextButton", {
		Parent = itemCard,
		LayoutOrder = nextOrder(),
		Size = UDim2.new(1, 0, 0, 40),
		Text = "Teleport to random Gem",
		TextColor3 = Theme.Text,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		BorderSizePixel = 0,
	}, { corner(8) })
	addButtonFeedback(randomBtn, Theme.Elevated, Theme.Stroke, Theme.Surface)
	local itemStatus = label(itemCard, "Status: off", 13, Theme.SubText, false)

	local watching = false
	local watchConn = nil
	local queue = {}
	local processing = false
	local seen = setmetatable({}, { __mode = "k" })

	-- Works for parts, meshes, models, attachments, or anything containing a part
	local function resolveTarget(inst)
		if inst:IsA("BasePart") then
			return inst.CFrame
		end
		if inst:IsA("Attachment") then
			return inst.WorldCFrame
		end
		if inst:IsA("Model") then
			if inst:FindFirstChildWhichIsA("BasePart", true) then
				return inst:GetPivot()
			end
			return nil -- model has no parts yet (still loading)
		end
		local part = inst:FindFirstChildWhichIsA("BasePart", true)
		return part and part.CFrame or nil
	end

	-- New items often get their parts a moment after they appear, so retry briefly
	local function waitForTarget(inst)
		for _ = 1, 10 do
			if not inst.Parent then
				return nil
			end
			local cf = resolveTarget(inst)
			if cf then
				return cf
			end
			task.wait(0.1)
		end
		return nil
	end

	local function getLivingRoot()
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if root and hum and hum.Health > 0 then
			return root, char
		end
		return nil, nil
	end

	local function teleportRoot(root, cf)
		root.CFrame = cf
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end

	local function processQueue()
		if processing then
			return
		end
		processing = true
		task.spawn(function()
			local origin, originChar = nil, nil

			while watching and #queue > 0 do
				local item = table.remove(queue, 1)
				local cf = waitForTarget(item)
				local root, char = getLivingRoot()
				if cf and root and item.Parent then
					-- Remember where we were before the first teleport of this batch
					if not origin or originChar ~= char then
						origin, originChar = root.CFrame, char
					end
					itemStatus.Text = "Status: teleported to " .. item.Name
					teleportRoot(root, cf + itemConfig.Offset)
					notify("Teleported to " .. item.Name)
					task.wait(math.max(0, tonumber(itemConfig.StaySeconds) or 0.5))
				end
			end

			-- Queue is empty (or watcher stopped): go back to the saved position
			if origin then
				local root, char = getLivingRoot()
				if root and char == originChar then
					teleportRoot(root, origin)
					itemStatus.Text = watching and "Status: returned, watching..." or "Status: off"
					notify("Returned to your position")
				end
			end

			processing = false
			-- an item may have arrived while we were returning
			if watching and #queue > 0 then
				processQueue()
			end
		end)
	end

	local function onInstance(inst)
		if not watching or not itemNames[inst.Name] or seen[inst] then
			return
		end
		-- ignore a same-named child of an item we already track
		if inst.Parent and itemNames[inst.Parent.Name] then
			return
		end
		seen[inst] = true
		table.insert(queue, inst)
		itemStatus.Text = "Status: found " .. inst.Name
		processQueue()
	end


	-- Random Gem: scan for every Gem that exists right now, pick one at random
	local function findGems()
		local gems = {}
		for _, inst in ipairs(workspace:GetDescendants()) do
			if itemNames[inst.Name] and not (inst.Parent and itemNames[inst.Parent.Name]) and resolveTarget(inst) then
				table.insert(gems, inst)
			end
		end
		return gems
	end

	local function teleportToRandomGem()
		if processing then
			itemStatus.Text = "Status: busy, try again in a moment"
			return
		end
		local gems = findGems()
		if #gems == 0 then
			itemStatus.Text = "Status: no Gems found right now"
			notify("No Gems found")
			return
		end
		local root, char = getLivingRoot()
		if not root then
			itemStatus.Text = "Status: character not ready"
			return
		end

		processing = true
		local gem = gems[math.random(1, #gems)]
		local cf = resolveTarget(gem)
		if cf and gem.Parent then
			itemStatus.Text = "Status: teleported to " .. gem.Name .. " (random of " .. #gems .. ")"
			teleportRoot(root, cf + itemConfig.Offset)
			notify("Teleported to " .. gem.Name)
		else
			itemStatus.Text = "Status: that Gem disappeared, try again"
		end
		processing = false

		-- a Gem may have spawned while we were busy
		if watching and #queue > 0 then
			processQueue()
		end
	end

	randomBtn.MouseButton1Click:Connect(function()
		task.spawn(teleportToRandomGem)
	end)

	itemBtn.MouseButton1Click:Connect(function()
		watching = not watching
		if watching then
			itemBtn.Text = "Stop gem watcher ✓"
			itemStatus.Text = "Status: watching..."
			table.clear(seen)
			table.clear(queue)
			watchConn = workspace.DescendantAdded:Connect(onInstance)
			if itemConfig.CheckExisting then
				for _, inst in ipairs(workspace:GetDescendants()) do
					onInstance(inst)
				end
			end
			notify("Gem watcher started")
		else
			itemBtn.Text = "Start gem watcher"
			itemStatus.Text = "Status: off"
			if watchConn then
				watchConn:Disconnect()
				watchConn = nil
			end
			table.clear(queue)
			notify("Gem watcher stopped")
		end
	end)

	-- Teleport to pasted coordinates (e.g. 5555, 5564, 5590)
	local coordCard = createCard(page, "Coordinates", "Paste coordinates like 5555, 5564, 5590 and tap Teleport.")
	local coordBox = create("TextBox", {
		Parent = coordCard,
		LayoutOrder = nextOrder(),
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = Theme.Elevated,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		ClipsDescendants = true,
		PlaceholderText = "X, Y, Z",
		PlaceholderColor3 = Theme.SubText,
		Text = "",
		TextColor3 = Theme.Text,
		Font = Enum.Font.Gotham,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, {
		corner(8),
		create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }),
	})
	local coordBtn = create("TextButton", {
		Parent = coordCard,
		LayoutOrder = nextOrder(),
		Size = UDim2.new(1, 0, 0, 40),
		Text = "Teleport to coordinates",
		TextColor3 = Theme.Text,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		BorderSizePixel = 0,
	}, { corner(8) })
	addButtonFeedback(coordBtn, Theme.Elevated, Theme.Stroke, Theme.Surface)
	local coordStatus = label(coordCard, "Status: waiting for coordinates", 13, Theme.SubText, false)

	-- Pulls the numbers out of the text, so "5555, 5564, 5590", "5555 5564 5590",
	-- "(5555, 5564, 5590)" and "Vector3.new(5555, 5564, 5590)" all work.
	local function parseCoordinates(text)
		local nums = {}
		for token in string.gmatch(text, "%-?%d*%.?%d+") do
			local n = tonumber(token)
			if n then
				table.insert(nums, n)
			end
		end
		if #nums == 3 then
			return Vector3.new(nums[1], nums[2], nums[3]), 3
		end
		return nil, #nums
	end

	coordBtn.MouseButton1Click:Connect(function()
		local pos, count = parseCoordinates(coordBox.Text)
		if not pos then
			coordStatus.Text = "Status: need 3 numbers (X, Y, Z), found " .. count
			return
		end
		local root = getLivingRoot()
		if not root then
			coordStatus.Text = "Status: character not ready"
			return
		end
		teleportRoot(root, CFrame.new(pos))
		coordStatus.Text = string.format("Status: teleported to %g, %g, %g", pos.X, pos.Y, pos.Z)
		notify("Teleported to coordinates")
	end)
end

-- Move (speed / fly / noclip)
do
	local RunService = game:GetService("RunService")
	local page = createPage()
	pages.Move = page

	local state = { Speed = false, Fly = false, Noclip = false, ESP = false }
	local values = { WalkSpeed = 50, FlySpeed = 60 }
	local flyUp, flyDown = false, false
	local flyBV, flyBG = nil, nil
	local savedWalkSpeed = nil
	local noclipOriginal = {}
