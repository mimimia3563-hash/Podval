			end
			box.Text = tostring(values[key])
		end)
	end
	numberRow("Walk speed", "WalkSpeed", 1, 500)
	numberRow("Fly speed", "FlySpeed", 1, 500)

	-- Fullbright (client-side lighting override, only you see it)
	local Lighting = game:GetService("Lighting")
	local fullbright = false
	local savedLighting = nil
	local savedAtmospheres = {} -- [Atmosphere] = { Density, Haze }
	local FULLBRIGHT_COLOR = Color3.fromRGB(190, 190, 190)

	local visualCard = createCard(page, "Visuals", "Fullbright removes darkness, shadows and fog so everything is lit.")
	local fbBtn = create("TextButton", {
		Parent = visualCard,
		LayoutOrder = nextOrder(),
		Size = UDim2.new(1, 0, 0, 40),
		Text = "Fullbright",
		TextColor3 = Theme.Text,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Elevated,
		BorderSizePixel = 0,
	}, { corner(8) })

	local function renderFullbright()
		fbBtn.Text = fullbright and "Fullbright ✓" or "Fullbright"
		tween(fbBtn, 0.2, { BackgroundColor3 = fullbright and Theme.Accent or Theme.Elevated })
	end
	onAccent(renderFullbright)

	local function setFullbright(value)
		if value == fullbright then
			return
		end
		fullbright = value
		if value then
			-- remember the game's lighting so we can put it back
			savedLighting = {
				Brightness = Lighting.Brightness,
				GlobalShadows = Lighting.GlobalShadows,
				Ambient = Lighting.Ambient,
				OutdoorAmbient = Lighting.OutdoorAmbient,
				FogEnd = Lighting.FogEnd,
			}
			table.clear(savedAtmospheres)
			for _, child in ipairs(Lighting:GetChildren()) do
				if child:IsA("Atmosphere") then
					savedAtmospheres[child] = { Density = child.Density, Haze = child.Haze }
				end
			end
		else
			if savedLighting then
				for prop, original in pairs(savedLighting) do
					Lighting[prop] = original
				end
				savedLighting = nil
			end
			for atmosphere, original in pairs(savedAtmospheres) do
				if atmosphere.Parent then
					atmosphere.Density = original.Density
					atmosphere.Haze = original.Haze
				end
			end
			table.clear(savedAtmospheres)
		end
		renderFullbright()
		notify("Fullbright " .. (value and "enabled" or "disabled"))
	end

	fbBtn.MouseButton1Click:Connect(function()
		setFullbright(not fullbright)
	end)

	-- Re-applied every frame, because many games keep changing their lighting
	RunService.Heartbeat:Connect(function()
		if not fullbright then
			return
		end
		Lighting.Brightness = 2
		Lighting.GlobalShadows = false
		Lighting.Ambient = FULLBRIGHT_COLOR
		Lighting.OutdoorAmbient = FULLBRIGHT_COLOR
		Lighting.FogEnd = 9e9
		for atmosphere in pairs(savedAtmospheres) do
			if atmosphere.Parent then
				atmosphere.Density = 0
				atmosphere.Haze = 0
			end
		end
	end)

	-- Keyboard up/down for fly (ignored while typing in a box)
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		local k = input.KeyCode
		if k == Enum.KeyCode.Space or k == Enum.KeyCode.E then
			flyUp = true
		elseif k == Enum.KeyCode.Q or k == Enum.KeyCode.LeftControl then
			flyDown = true
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		local k = input.KeyCode
		if k == Enum.KeyCode.Space or k == Enum.KeyCode.E then
			flyUp = false
		elseif k == Enum.KeyCode.Q or k == Enum.KeyCode.LeftControl then
			flyDown = false
		end
	end)

	local function clearFly(hum)
		if flyBV then
			flyBV:Destroy()
			flyBV = nil
		end
		if flyBG then
			flyBG:Destroy()
			flyBG = nil
		end
		if hum then
			hum.AutoRotate = true
		end
	end

	-- Speed + Fly (runs every frame, survives respawns)
	RunService.Heartbeat:Connect(function()
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")

		-- Speed
		if state.Speed then
			if hum then
				if savedWalkSpeed == nil then
					savedWalkSpeed = hum.WalkSpeed
				end
				hum.WalkSpeed = values.WalkSpeed
			end
		elseif savedWalkSpeed ~= nil and hum then
			hum.WalkSpeed = savedWalkSpeed
			savedWalkSpeed = nil
		end

		-- Fly
		if state.Fly and hum and root and hum.Health > 0 then
			if not flyBV or flyBV.Parent ~= root then
				clearFly(nil)
				flyBV = Instance.new("BodyVelocity")
				flyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
				flyBV.Velocity = Vector3.zero
				flyBV.Parent = root
				flyBG = Instance.new("BodyGyro")
				flyBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
				flyBG.P = 9e4
				flyBG.CFrame = root.CFrame
				flyBG.Parent = root
			end
			hum.AutoRotate = false

			local cf = workspace.CurrentCamera.CFrame
			local look, right = cf.LookVector, cf.RightVector
			local flat = Vector3.new(look.X, 0, look.Z)
			local flatUnit = flat.Magnitude > 0.001 and flat.Unit or nil
			local md = hum.MoveDirection

			local dir = Vector3.zero
			if flatUnit and md.Magnitude > 0 then
				dir = look * md:Dot(flatUnit) + right * md:Dot(right)
			end
			-- hum.Jump is true while the phone's jump button (or Space) is held
			local up = flyUp or hum.Jump
			dir += Vector3.new(0, (up and 1 or 0) - (flyDown and 1 or 0), 0)
			if dir.Magnitude > 1 then
				dir = dir.Unit
			end
			flyBV.Velocity = dir * values.FlySpeed
			if flatUnit then
				flyBG.CFrame = CFrame.lookAt(root.Position, root.Position + flatUnit)
			end
		elseif flyBV or flyBG then
			clearFly(hum)
		end
	end)

	-- Noclip (physics step, restores original collisions when turned off)
	RunService.Stepped:Connect(function()
		local char = player.Character
		if state.Noclip and char then
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					if noclipOriginal[part] == nil then
						noclipOriginal[part] = part.CanCollide
					end
					part.CanCollide = false
				end
			end
		elseif next(noclipOriginal) ~= nil then
			for part, original in pairs(noclipOriginal) do
				if part.Parent then
					part.CanCollide = original
				end
			end
			table.clear(noclipOriginal)
		end
	end)
end

-- Players (check a player: noclip + anchored under them, returns when they die)
do
	local RunService = game:GetService("RunService")
	local page = createPage()
	pages.Players = page

	local depth = tonumber(CONFIG.CheckPlayer.DepthStuds) or 5
	local checkTarget, checkChar = nil, nil -- player being checked + their current character
	local checkOrigin, checkMyChar = nil, nil -- where you were + which of your characters it belongs to
	local checkNoclipWasOn = false
	local rows = {}
	local startCheck, stopCheck

	local card = createCard(
		page,
		"Check player",
		"Tap a player below. Noclip turns on and you are anchored " .. depth .. " studs under them, facing up. If they die or leave, you return to your original position."
	)
	local statusLabel = label(card, "Status: not checking", 13, Theme.SubText, false)
	local stopBtn = create("TextButton", {
		Parent = card,
		LayoutOrder = nextOrder(),
		Size = UDim2.new(1, 0, 0, 40),
		Text = "Stop checking and return",
		TextColor3 = Theme.Text,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		BorderSizePixel = 0,
	}, { corner(8) })
	addButtonFeedback(stopBtn, Theme.Elevated, Theme.Stroke, Theme.Surface)

	local listCard = createCard(page, "Players")
	local emptyLabel = label(listCard, "No other players in the server.", 13, Theme.SubText, false)
	local listFrame = create("Frame", {
		Parent = listCard,
		LayoutOrder = nextOrder(),
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, {
		create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	-- Always-visible stop chip while checking (the panel may be closed)
	local chip = create("TextButton", {
		Name = "CheckChip",
		Parent = gui,
		Visible = false,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, TOP_SAFE + 6),
		Size = UDim2.fromOffset(240, 36),
		Text = "",
		TextColor3 = Color3.new(1, 1, 1),
		TextTruncate = Enum.TextTruncate.AtEnd,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		AutoButtonColor = false,
		BackgroundColor3 = Color3.fromRGB(205, 72, 84),
		BorderSizePixel = 0,
		ZIndex = 6,
	}, { pill() })

	local function playerLabel(plr)
		if plr.DisplayName == plr.Name then
			return plr.Name
		end
		return plr.DisplayName .. "  (@" .. plr.Name .. ")"
	end

	local function refreshRows()
		emptyLabel.Visible = next(rows) == nil
		for plr, btn in pairs(rows) do
			local active = (plr == checkTarget)
			btn.Text = (active and "✓  " or "") .. playerLabel(plr)
			tween(btn, 0.2, { BackgroundColor3 = active and Theme.Accent or Theme.Elevated })
		end
	end
	onAccent(refreshRows)

	local function addRow(plr)
		if plr == player or rows[plr] then
			return
		end
		local btn = create("TextButton", {
			Parent = listFrame,
			LayoutOrder = nextOrder(),
			Size = UDim2.new(1, 0, 0, 40),
			BackgroundColor3 = Theme.Elevated,
			AutoButtonColor = false,
			BorderSizePixel = 0,
			Text = playerLabel(plr),
			TextColor3 = Theme.Text,
			Font = Enum.Font.GothamMedium,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		}, {
			corner(8),
			create("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }),
		})
		rows[plr] = btn
		btn.MouseButton1Click:Connect(function()
			if checkTarget == plr then
				stopCheck("Status: stopped, returned to your position", true)
			else
				startCheck(plr)
			end
		end)
		refreshRows()
	end

	local function removeRow(plr)
		local btn = rows[plr]
		if btn then
			btn:Destroy()
			rows[plr] = nil
		end
		refreshRows()
	end

	stopCheck = function(message, doReturn)
		if not checkTarget then
			statusLabel.Text = "Status: not checking"
			return
		end
		local myChar = player.Character
		local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
		local origin = checkOrigin
		local sameChar = (myChar == checkMyChar)
		checkTarget, checkChar, checkOrigin, checkMyChar = nil, nil, nil, nil

		if myRoot and sameChar then
			myRoot.Anchored = false
			if doReturn and origin then
				myRoot.CFrame = origin
				myRoot.AssemblyLinearVelocity = Vector3.zero
				myRoot.AssemblyAngularVelocity = Vector3.zero
			end
		end
		if shared.setMoveState and not checkNoclipWasOn then
			shared.setMoveState("Noclip", false)
		end

		chip.Visible = false
		statusLabel.Text = message or "Status: stopped"
		refreshRows()
	end

	startCheck = function(plr)
		local myChar = player.Character
		local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
		local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
		if not (myRoot and myHum and myHum.Health > 0) then
			statusLabel.Text = "Status: your character is not ready"
			return
		end

		local char = plr.Character
		local tRoot = char and char:FindFirstChild("HumanoidRootPart")
		local tHum = char and char:FindFirstChildOfClass("Humanoid")
		if not (tRoot and tHum and tHum.Health > 0) then
			statusLabel.Text = "Status: " .. plr.DisplayName .. " has no living character you can see (dead or too far away)"
			return
		end

		-- First check of this session: remember where we were and set up noclip
		if not checkTarget then
			checkOrigin = myRoot.CFrame
			checkMyChar = myChar
			local moveState = shared.moveState
			checkNoclipWasOn = moveState and moveState.Noclip or false
			if shared.setMoveState then
				if moveState and moveState.Fly then
					shared.setMoveState("Fly", false)
				end
				if not checkNoclipWasOn then
					shared.setMoveState("Noclip", true)
				end
			end
		end

		checkTarget, checkChar = plr, char
		chip.Text = "✕  Stop checking " .. plr.DisplayName
		chip.Visible = true
		statusLabel.Text = "Status: checking " .. plr.DisplayName .. " (" .. depth .. " studs under, facing up)"
		refreshRows()
		notify("Checking " .. plr.DisplayName)

		-- On phones the panel covers the screen, so close it. Use the red chip or the 🛠 button.
		if mobile then
			setOpen(false)
		end
	end

	stopBtn.MouseButton1Click:Connect(function()
		stopCheck("Status: stopped, returned to your position", true)
	end)
	chip.MouseButton1Click:Connect(function()
		stopCheck("Status: stopped, returned to your position", true)
	end)

	-- Hold position under the target every frame; watch for deaths
	RunService.Heartbeat:Connect(function()
		local target = checkTarget
		if not target then
			return
		end

		local myChar = player.Character
		local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
		local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
		if not myRoot or not myHum or myHum.Health <= 0 or myChar ~= checkMyChar then
			stopCheck("Status: you died or respawned, check stopped", false)
			return
		end

		local char = target.Character
		local tRoot = char and char:FindFirstChild("HumanoidRootPart")
		local tHum = char and char:FindFirstChildOfClass("Humanoid")
		local targetAlive = target.Parent == Players
			and char == checkChar
			and tRoot ~= nil
			and tRoot.Parent ~= nil
			and tHum ~= nil
			and tHum.Health > 0
		if not targetAlive then
			stopCheck("Status: " .. target.DisplayName .. " died or left. Returned to your position.", true)
			notify(target.DisplayName .. " died or left, returned")
			return
		end

		-- 90 degrees around X makes the character face straight up (lying on its back)
		myRoot.Anchored = true
		myRoot.CFrame = CFrame.new(tRoot.Position - Vector3.new(0, depth, 0)) * CFrame.Angles(math.rad(90), 0, 0)
	end)

	for _, plr in ipairs(Players:GetPlayers()) do
		addRow(plr)
	end
	Players.PlayerAdded:Connect(addRow)
	Players.PlayerRemoving:Connect(removeRow)
	refreshRows()
end

