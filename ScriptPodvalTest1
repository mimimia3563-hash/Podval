			sound.Ended:Connect(function()
				sound:Destroy()
			end)
			sound:Play()
			-- warn if the audio never loads (private, removed, or wrong id)
			task.delay(8, function()
				if sound.Parent and not sound.IsLoaded then
					warn("[AdminPanelUI] load sound did not load (id " .. tostring(soundConfig.Id) .. "): it may be private or removed")
				end
			end)
		end
	end
end

print(string.format(
	"[AdminPanelUI] started | mobile=%s | screen=%.0fx%.0f",
	tostring(mobile),
	getScreen().X,
	getScreen().Y
))

if debugLabel then
	task.spawn(function()
		while gui.Parent do
			local gs = gui.AbsoluteSize
			debugLabel.Text = string.format(
				"mode:%s touch:%s kb:%s\ngui:%.0fx%.0f  win:%.0f,%.0f %.0fx%.0f\nvisible:%s open:%s",
				mobile and "MOBILE" or "PC",
				tostring(UserInputService.TouchEnabled),
				tostring(UserInputService.KeyboardEnabled),
				gs.X,
				gs.Y,
				window.AbsolutePosition.X,
				window.AbsolutePosition.Y,
				window.AbsoluteSize.X,
				window.AbsoluteSize.Y,
				tostring(window.Visible),
				tostring(isOpen)
			)
			task.wait(0.5)
		end
	end)
end

end -- main

local ok, err = xpcall(main, debug.traceback)
if not ok then
	warn("[AdminPanelUI] " .. tostring(err))
	showFatal(err)
end
