------------------------------------------------------------------------
-- STATE + LAYOUT
------------------------------------------------------------------------
local isOpen = false
local minimized = false
local placed = false
local fullSize = CONFIG.MaxSize
local windowPos = Vector2.zero
local togglePos = Vector2.zero
local currentTween = nil
local tabs = {}
local activeTab = nil

local function getScreen()
	local s = gui.AbsoluteSize
	if s.X < 10 or s.Y < 10 then
		local cam = workspace.CurrentCamera
		if cam then
			s = cam.ViewportSize
		end
	end
	return s
end

local function currentWindowSize()
	return Vector2.new(fullSize.X, minimized and topbarH or fullSize.Y)
end

local function clampWindowPos(pos, size)
	local s = getScreen()
	local maxX = math.max(0, s.X - size.X)
	local maxY = math.max(TOP_SAFE, s.Y - size.Y)
	return Vector2.new(math.clamp(pos.X, 0, maxX), math.clamp(pos.Y, TOP_SAFE, maxY))
end

local function setWindowPos(pos)
	windowPos = clampWindowPos(pos, currentWindowSize())
	window.Position = UDim2.fromOffset(windowPos.X, windowPos.Y)
end

local function setTogglePos(pos)
	local s = getScreen()
	togglePos = Vector2.new(
		math.clamp(pos.X, 0, math.max(0, s.X - toggleSize)),
		math.clamp(pos.Y, TOP_SAFE, math.max(TOP_SAFE, s.Y - toggleSize))
	)
	toggleBtn.Position = UDim2.fromOffset(togglePos.X, togglePos.Y)
end

local function centerWindow(animate)
	local s = getScreen()
	local size = currentWindowSize()
	windowPos = clampWindowPos((s - size) / 2, size)
	local goal = UDim2.fromOffset(windowPos.X, windowPos.Y)
	if animate then
		tween(window, 0.4, { Position = goal })
	else
		window.Position = goal
	end
end

local function ensureOnScreen()
	if not isOpen or not window.Visible then
		return
	end
	local gs = gui.AbsoluteSize
	if gs.X < 10 then
		return
	end
	local p, sz = window.AbsolutePosition, window.AbsoluteSize
	local tol = 24
	if p.X < -tol or p.Y < -tol or p.X + sz.X > gs.X + tol or p.Y + sz.Y > gs.Y + tol then
		centerWindow(true)
	end
end

local function updateToggleVisibility()
	toggleBtn.Visible = not (mobile and isOpen)
end

local function barSize(on)
	if mobile then
		return UDim2.fromOffset(on and 18 or 0, 3)
	end
	return UDim2.fromOffset(3, on and 18 or 0)
end

local function applyLayout()
	local s = getScreen()
	fullSize = Vector2.new(
		math.clamp(s.X - 24, 240, CONFIG.MaxSize.X),
		math.clamp(s.Y - TOP_SAFE - 12, 180, CONFIG.MaxSize.Y)
	)
	local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	mobile = touchOnly or fullSize.X < CONFIG.NarrowBreakpoint

	topbarH = mobile and 48 or 40
	toggleSize = mobile and 54 or 46

	local bw = mobile and 42 or 34
	local bh = mobile and 36 or 30
	closeBtn.Size = UDim2.fromOffset(bw, bh)
	minBtn.Size = UDim2.fromOffset(bw, bh)
	closeBtn.Position = UDim2.new(1, -10, 0.5, 0)
	minBtn.Position = UDim2.new(1, -(10 + bw + 8), 0.5, 0)
	titleLabel.Size = UDim2.new(1, -(34 + 18 + bw * 2 + 8), 1, 0)
	topbar.Size = UDim2.new(1, 0, 0, topbarH)

	toggleBtn.Size = UDim2.fromOffset(toggleSize, toggleSize)
	toggleBtn.TextSize = mobile and 26 or 22

	local size = currentWindowSize()
	window.Size = UDim2.fromOffset(size.X, size.Y)
	body.Position = UDim2.fromOffset(0, topbarH)
	local bodyH = fullSize.Y - topbarH
	body.Size = UDim2.new(1, 0, 0, bodyH)

	local n = #TAB_DEFS
	if mobile then
		sideLayout.FillDirection = Enum.FillDirection.Horizontal
		sidebar.Position = UDim2.fromOffset(0, bodyH - TAB_BAR_H)
		sidebar.Size = UDim2.new(1, 0, 0, TAB_BAR_H)
		content.Position = UDim2.fromOffset(0, 0)
		content.Size = UDim2.new(1, 0, 0, bodyH - TAB_BAR_H)
	else
		sideLayout.FillDirection = Enum.FillDirection.Vertical
		sidebar.Position = UDim2.fromOffset(0, 0)
		sidebar.Size = UDim2.new(0, 128, 1, 0)
		content.Position = UDim2.fromOffset(128, 0)
		content.Size = UDim2.new(1, -128, 1, 0)
	end

	for _, def in ipairs(TAB_DEFS) do
		local t = tabs[def.name]
		if t then
			if mobile then
				t.btn.Size = UDim2.new(1 / n, -(6 * (n - 1)) / n, 1, 0)
				t.btn.Text = def.icon .. " " .. def.name
				t.btn.TextXAlignment = Enum.TextXAlignment.Center
				t.btn.TextSize = n > 3 and 12 or 13
				t.bar.AnchorPoint = Vector2.new(0.5, 1)
				t.bar.Position = UDim2.new(0.5, 0, 1, -3)
			else
				t.btn.Size = UDim2.new(1, 0, 0, 38)
				t.btn.Text = "   " .. def.icon .. "  " .. def.name
				t.btn.TextXAlignment = Enum.TextXAlignment.Left
				t.btn.TextSize = 14
				t.bar.AnchorPoint = Vector2.new(0, 0.5)
				t.bar.Position = UDim2.new(0, 2, 0.5, 0)
			end
			t.bar.Size = barSize(activeTab == def.name)
		end
	end

	if not placed then
		placed = true
		centerWindow(false)
		if mobile then
			setTogglePos(Vector2.new(s.X - toggleSize - 12, s.Y * 0.35))
		else
			setTogglePos(Vector2.new(12, s.Y / 2 - toggleSize / 2))
		end
	else
		setWindowPos(windowPos)
		setTogglePos(togglePos)
	end
	updateToggleVisibility()
end

------------------------------------------------------------------------
-- OPEN / CLOSE / MINIMIZE
------------------------------------------------------------------------
local function setOpen(open)
	if open == isOpen then
		return
	end
	isOpen = open
	updateToggleVisibility()
	if currentTween then
		currentTween:Cancel()
	end

	local rest = UDim2.fromOffset(windowPos.X, windowPos.Y)
	local shifted = UDim2.fromOffset(windowPos.X, windowPos.Y + 18)

	if open then
		window.Visible = true
		window.Position = shifted
		currentTween = tween(window, 0.35, { GroupTransparency = 0, Position = rest })
		task.delay(0.6, ensureOnScreen)
	else
		currentTween = tween(
			window,
			0.22,
			{ GroupTransparency = 1, Position = shifted },
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.In
		)
		currentTween.Completed:Once(function()
			if not isOpen then
				window.Visible = false
			end
		end)
	end
end

local function setMinimized(state)
	minimized = state
	minBtn.Text = state and "+" or "–"
	local size = currentWindowSize()
	windowPos = clampWindowPos(windowPos, size)
	tween(window, 0.35, {
		Size = UDim2.fromOffset(size.X, size.Y),
		Position = UDim2.fromOffset(windowPos.X, windowPos.Y),
	})
end

------------------------------------------------------------------------
-- DRAGGING (mouse + touch)
------------------------------------------------------------------------
local activeDrag = nil

-- Shared input listeners: only one InputChanged and one InputEnded connection
-- are needed for both draggable elements.
UserInputService.InputChanged:Connect(function(input)
	local drag = activeDrag
	if not drag then
		return
	end
	if input == drag.input or input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - drag.startInput
		if not drag.moved and delta.Magnitude > 8 then
			drag.moved = true
		end
		if drag.moved then
			drag.setPos(drag.startPos + Vector2.new(delta.X, delta.Y))
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	local drag = activeDrag
	if not drag then
		return
	end
	local isEnd = input == drag.input
		or (drag.input.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)
	if isEnd then
		activeDrag = nil
		if not drag.moved and drag.onTap then
			drag.onTap()
		end
	end
end)

local function makeDraggable(handle, getPos, setPos, onTap)
	handle.InputBegan:Connect(function(input)
		local inputType = input.UserInputType
		if inputType ~= Enum.UserInputType.MouseButton1 and inputType ~= Enum.UserInputType.Touch then
			return
		end
		activeDrag = {
			input = input,
			startInput = input.Position,
			startPos = getPos(),
			setPos = setPos,
			onTap = onTap,
			moved = false,
		}
	end)
end

makeDraggable(topbar, function()
	return windowPos
end, setWindowPos)

makeDraggable(toggleBtn, function()
	return togglePos
end, setTogglePos, function()
	setOpen(not isOpen)
end)

