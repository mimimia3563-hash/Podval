local orderCounter = 0
local function nextOrder()
	orderCounter += 1
	return orderCounter
end

local function tween(obj, duration, props, style, direction)
	local t = TweenService:Create(
		obj,
		TweenInfo.new(duration, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

local function create(className, props, children)
	local inst = Instance.new(className)
	local parent = props.Parent
	for k, v in pairs(props) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	inst.Parent = parent
	return inst
end

local function corner(radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius) })
end

local function pill()
	return create("UICorner", { CornerRadius = UDim.new(1, 0) })
end

local accentListeners = {}
local function onAccent(fn)
	table.insert(accentListeners, fn)
	fn(true)
end

local function trackAccent(inst, prop)
	onAccent(function(instant)
		if instant then
			inst[prop] = Theme.Accent
		else
			tween(inst, 0.25, { [prop] = Theme.Accent })
		end
	end)
end

local function setAccent(color)
	Theme.Accent = color
	for _, fn in ipairs(accentListeners) do
		fn(false)
	end
end

local function addButtonFeedback(btn, normal, hover, press)
	press = press or hover
	btn.AutoButtonColor = false
	btn.BackgroundColor3 = normal
	local hovering = false
	btn.MouseEnter:Connect(function()
		hovering = true
		tween(btn, 0.15, { BackgroundColor3 = hover })
	end)
	btn.MouseLeave:Connect(function()
		hovering = false
		tween(btn, 0.15, { BackgroundColor3 = normal })
	end)
	btn.MouseButton1Down:Connect(function()
		tween(btn, 0.08, { BackgroundColor3 = press })
	end)
	btn.MouseButton1Up:Connect(function()
		tween(btn, 0.15, { BackgroundColor3 = hovering and hover or normal })
	end)
end

