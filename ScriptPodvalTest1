			end
		elseif name == "ESP" then
			refreshEsp()
		end
		notify(name .. (value and " enabled" or " disabled"))
	end

	shared.setMoveState = setState
	shared.moveState = state

	for _, name in ipairs({ "Speed", "Fly", "Noclip", "ESP" }) do
		local b = create("TextButton", {
			Parent = barRow,
