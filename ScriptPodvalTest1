	end, true)
	padButton("✕", 3, function()
		setState("Fly", false)
	end, false, Color3.fromRGB(205, 72, 84))


	-- ESP: highlight + name/distance tag on every other player (client-side only)
	local espObjects = {} -- [Player] = { highlight, billboard, label }

	local function removeEsp(plr)
		local o = espObjects[plr]
		if o then
			if o.highlight then
				o.highlight:Destroy()
			end
			if o.billboard then
				o.billboard:Destroy()
			end
			espObjects[plr] = nil
		end
	end

	local function applyEsp(plr, char)
		removeEsp(plr)
		if not state.ESP or plr == player or not char then
			return
		end
		local head = char:FindFirstChild("Head") or char:WaitForChild("Head", 5)
		if not head or not state.ESP or plr.Character ~= char then
			return
		end
		removeEsp(plr) -- in case another call finished while we were waiting

		local highlight = create("Highlight", {
			Name = "AdminESP",
			Adornee = char,
			FillColor = Color3.fromRGB(255, 70, 90),
			FillTransparency = 0.65,
			OutlineColor = Color3.new(1, 1, 1),
			OutlineTransparency = 0,
			DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
			Parent = char,
		})
		local billboard = create("BillboardGui", {
			Name = "AdminESP",
			Adornee = head,
			AlwaysOnTop = true,
			LightInfluence = 0,
			Size = UDim2.fromOffset(140, 40),
			StudsOffset = Vector3.new(0, 2.6, 0),
			Parent = head,
		})
		local text = create("TextLabel", {
			Parent = billboard,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Text = plr.DisplayName,
			TextColor3 = Color3.new(1, 1, 1),
			TextStrokeTransparency = 0.4,
			Font = Enum.Font.GothamBold,
			TextSize = 13,
		})
		espObjects[plr] = { highlight = highlight, billboard = billboard, label = text }
	end

	local function refreshEsp()
		if state.ESP then
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= player and plr.Character then
					task.spawn(applyEsp, plr, plr.Character)
				end
			end
		else
			for plr in pairs(espObjects) do
				removeEsp(plr)
			end
		end
	end

	local function hookEspPlayer(plr)
		if plr == player then
			return
		end
		plr.CharacterAdded:Connect(function(char)
			if state.ESP then
				task.spawn(applyEsp, plr, char)
			end
		end)
		plr.CharacterRemoving:Connect(function()
			removeEsp(plr)
		end)
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		hookEspPlayer(plr)
	end
	Players.PlayerAdded:Connect(hookEspPlayer)
	Players.PlayerRemoving:Connect(removeEsp)

	-- Keep the distance text fresh
	task.spawn(function()
		while gui.Parent do
			if state.ESP then
				local myChar = player.Character
				local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
				for plr, o in pairs(espObjects) do
					local theirChar = plr.Character
					local root = theirChar and theirChar:FindFirstChild("HumanoidRootPart")
					if o.label and o.label.Parent then
						local line = plr.DisplayName
						if myRoot and root then
							line = line .. "\n" .. math.floor((myRoot.Position - root.Position).Magnitude) .. " studs"
						end
						o.label.Text = line
					end
				end
			end
			task.wait(0.25)
		end
	end)

	-- Quick bar
	local barCard = createCard(
		page,
		"Quick bar",
		"Tap to toggle. Fly on PC: WASD to move, Space/E up, Q down. Fly on phone: thumbstick to move, ▲ ▼ or the jump button for up/down, ✕ to stop."
	)
	local barRow = create("Frame", {
		Parent = barCard,
		LayoutOrder = nextOrder(),
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 44),
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
