local function createToggle(parent, text, key)
	local row = create("Frame", {
		Parent = parent,
		LayoutOrder = nextOrder(),
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 38),
	})
	create("TextLabel", {
		Parent = row,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -60, 1, 0),
		Text = text,
		TextColor3 = Theme.Text,
		Font = Enum.Font.Gotham,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local track = create("TextButton", {
		Parent = row,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(48, 26),
		Text = "",
		AutoButtonColor = false,
		BorderSizePixel = 0,
		BackgroundColor3 = Theme.Stroke,
	}, { pill() })
	local knob = create("Frame", {
		Parent = track,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(20, 20),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, { pill() })

	local function render(animate)
		local on = Settings[key]
		local goalPos = on and UDim2.new(1, -23, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
		local goalColor = on and Theme.Accent or Theme.Stroke
		if animate then
			tween(knob, 0.2, { Position = goalPos })
			tween(track, 0.2, { BackgroundColor3 = goalColor })
		else
			knob.Position = goalPos
			track.BackgroundColor3 = goalColor
		end
	end

	track.MouseButton1Click:Connect(function()
		Settings[key] = not Settings[key]
		render(true)
	end)
	onAccent(function(instant)
		render(not instant)
	end)
end

