local function selectTab(name)
	if activeTab == name then
		return
	end
	activeTab = name
	for n, t in pairs(tabs) do
		local on = (n == name)
		tween(t.btn, 0.2, {
			BackgroundTransparency = on and 0 or 1,
			TextColor3 = on and Theme.Text or Theme.SubText,
		})
		tween(t.bar, 0.25, { Size = barSize(on) })
		if on then
			t.page.Position = UDim2.fromOffset(14, 0)
			t.page.Visible = true
			tween(t.page, 0.3, { Position = UDim2.fromOffset(0, 0) })
		else
			t.page.Visible = false
		end
	end
end

for _, def in ipairs(TAB_DEFS) do
	local btn = create("TextButton", {
		Parent = sidebar,
		LayoutOrder = nextOrder(),
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundColor3 = Theme.Elevated,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
	}, { corner(8) })

	local bar = create("Frame", {
		Parent = btn,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 2, 0.5, 0),
		Size = UDim2.fromOffset(3, 0),
		BorderSizePixel = 0,
	}, { pill() })
	trackAccent(bar, "BackgroundColor3")

	tabs[def.name] = { btn = btn, bar = bar, page = pages[def.name] }

	btn.MouseEnter:Connect(function()
		if activeTab ~= def.name then
			tween(btn, 0.15, { BackgroundTransparency = 0.5 })
		end
	end)
	btn.MouseLeave:Connect(function()
		if activeTab ~= def.name then
			tween(btn, 0.15, { BackgroundTransparency = 1 })
		end
	end)
	btn.MouseButton1Click:Connect(function()
		selectTab(def.name)
	end)
end

