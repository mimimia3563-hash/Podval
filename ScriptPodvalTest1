local function showFatal(err)
	local g = Instance.new("ScreenGui")
	g.Name = "AdminPanelError"
	g.ResetOnSpawn = false
	g.DisplayOrder = 999
	g.Parent = playerGui
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, -20, 0, 160)
	l.Position = UDim2.fromOffset(10, 50)
	l.BackgroundColor3 = Color3.fromRGB(120, 20, 30)
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextWrapped = true
	l.TextSize = 13
	l.Font = Enum.Font.Code
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextYAlignment = Enum.TextYAlignment.Top
	l.Text = "AdminPanelUI ERROR:\n" .. string.sub(tostring(err), 1, 700)
	l.Parent = g
end

